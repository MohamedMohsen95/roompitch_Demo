# Copy this file to ".env" for local use. On Vercel, add these in Project → Settings → Environment Variables.
# Leave all AI keys empty to run in demo mode.

# ── Option 1 (free to try): Cloudflare Workers AI ──
# Free plan includes 10,000 neurons per day (roughly 100 renders), reset at 00:00 UTC.
# Account ID: Cloudflare dashboard → Workers & Pages (right sidebar), or the URL after dash.cloudflare.com/
# Token: dash.cloudflare.com/profile/api-tokens → Create Token → "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct   (finds doors/windows in room photos; also try @cf/mistralai/mistral-small-3.1-24b-instruct or @cf/google/gemma-3-12b-it)
# CF_PLAN_MODEL=   (reads floor plans; empty = same model as CF_VISION_MODEL)
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b   (klein-9b looks better but costs ~10x more of the free allowance)

# ── Option 2 (paid, best quality): fal.ai ──
# https://fal.ai/dashboard/keys
FAL_KEY=
# FAL_RESTYLE_MODEL=fal-ai/nano-banana/edit
# FAL_INPAINT_MODEL=fal-ai/flux-pro/v1/fill

# If both are set, Cloudflare is used. Force one with: AI_PROVIDER=fal  (or cloudflare)

# Optional: a code the app must send, so strangers can't use your AI credit.
# If you set it, enter the same code in the app under "Studio".
ACCESS_CODE=

# ── Optional: Supabase (saves each room to the cloud as well as this browser) ──
# Supabase → Project Settings → API keys. These two reach the browser, so never put a secret key here.
# Connecting Supabase to the Vercel project sets them on Vercel automatically.
# Also turn on Authentication → Sign In / Providers → "Allow anonymous sign-ins".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for `npm run db:studio` (Drizzle). Server-side only: never prefix it with NEXT_PUBLIC_ or VITE_.
# Supabase → Connect → Session pooler connection string.
# DATABASE_URL=

# Only for `npm run catalog:sync` (uploads built-in models). Bypasses all RLS: server and scripts only,
# never prefix it with NEXT_PUBLIC_ or VITE_. Supabase → Project Settings → API keys → Secret keys.
# SUPABASE_SECRET_KEY=
